{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/references",
			"!**/dist",
			"!**/node_modules",
			"!**/.svelte-kit",
			"!**/.astro",
			"!**/.wrangler",
			"!**/_app",
			"!**/build",
			"!**/coverage",
			"!**/fixtures",
			"!**/*.html",
			"!**/*.css",
			"!**/*.svg",
			"!**/*.generated.*",
			"!**/platform/daemon-rs/contracts/replay-corpus",
			"!**/web/marketing/public/contentIndex.json",
			"!**/web/marketing/public/marketing",
			"!**/memorybench/data",
			"!**/memorybench/dist",
			"!**/memorybench/node_modules"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noAssignInExpressions": "off",
				"noExplicitAny": "warn"
			},
			"style": {
				"noNonNullAssertion": "warn"
			},
			"complexity": {
				"noForEach": "warn",
				"noBannedTypes": "warn"
			}
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab"
		}
	},
	"overrides": [
		{
			"includes": ["**/memorybench/**"],
			"formatter": {
				"enabled": false
			},
			"assist": { "actions": { "source": { "organizeImports": "off" } } },
			"linter": {
				"enabled": true,
				"rules": {
					"preset": "none",
					"correctness": {
						"noUnusedImports": "error",
						"noUnusedVariables": "error"
					},
					"style": {
						"noNonNullAssertion": "off",
						"useNodejsImportProtocol": "off",
						"noInferrableTypes": "off",
						"useImportType": "off",
						"useNumberNamespace": "off",
						"useTemplate": "off",
						"noUselessElse": "off",
						"noUnusedTemplateLiteral": "off"
					},
					"complexity": {
						"noStaticOnlyClass": "off",
						"noThisInStatic": "off",
						"noForEach": "off"
					},
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		}
	]
}
