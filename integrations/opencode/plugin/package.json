{
  "name": "@signet/opencode-plugin",
  "version": "0.163.18",
  "description": "Signet runtime plugin for OpenCode — memory tools and session lifecycle hooks",
  "type": "module",
  "main": "dist/signet.mjs",
  "types": "dist/signet.d.ts",
  "exports": {
    ".": {
      "import": "./dist/signet.mjs",
      "types": "./dist/signet.d.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/signet.mjs --target node --minify --format esm --external better-sqlite3",
    "typecheck": "tsc --noEmit",
    "dev": "bun --watch src/index.ts"
  },
  "dependencies": {
    "@signet/core": "workspace:*"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.1.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.13",
    "@types/node": "^22.0.0",
    "bun-types": "latest",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "signet",
    "opencode",
    "plugin",
    "ai-memory"
  ],
  "license": "Apache-2.0"
}
