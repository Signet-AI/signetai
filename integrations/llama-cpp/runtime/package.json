{
  "name": "@signet/llama-cpp-runtime",
  "version": "0.113.1",
  "description": "Interactive chat runtime for llama.cpp with Signet tool calling",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "signet-llama-chat": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
