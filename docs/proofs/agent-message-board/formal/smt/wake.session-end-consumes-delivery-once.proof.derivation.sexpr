(let ((a!1 (not (> s_delivered
                   (ite (> s_delivered s_boundary) s_global s_boundary))))
      (a!2 (not (<= s_delivered
                    (ite (<= s_delivered s_boundary) s_boundary s_global))))
      (a!4 (ite (<= (+ s_delivered (* (- 1) s_boundary)) 0) s_boundary s_global))
      (a!7 (ite (>= (+ s_boundary (* (- 1) s_delivered)) 0) s_boundary s_global))
      (a!9 (mp (asserted (>= s_global s_delivered))
               (rewrite (= (>= s_global s_delivered) (>= s_global s_delivered)))
               (>= s_global s_delivered)))
      (a!10 (= (>= s_global s_delivered)
               (>= (+ s_global (* (- 1) s_delivered)) 0)))
      (a!15 (not (>= (+ s_boundary (* (- 1) s_delivered)) 0)))
      (a!16 (hypothesis (>= (+ s_boundary (* (- 1) s_delivered)) 0))))
(let ((a!3 (mp (asserted (not a!1)) (rewrite (= (not a!1) a!2)) a!2))
      (a!5 (not (<= (+ s_delivered (* (- 1) a!4)) 0)))
      (a!8 (not (>= (+ a!7 (* (- 1) s_delivered)) 0)))
      (a!11 (mp a!9 (rewrite a!10) (>= (+ s_global (* (- 1) s_delivered)) 0)))
      (a!12 (or (not (= a!7 s_global)) (>= (+ a!7 (* (- 1) s_global)) 0)))
      (a!13 (or (>= (+ s_boundary (* (- 1) s_delivered)) 0) (= a!7 s_global)))
      (a!14 (or (not (= a!7 s_boundary)) (>= (+ a!7 (* (- 1) s_boundary)) 0)))
      (a!17 (unit-resolution (def-axiom (or a!15 (= a!7 s_boundary)))
                             a!16
                             (= a!7 s_boundary))))
(let ((a!6 (mp (mp a!3 (rewrite (= a!2 a!2)) a!2) (rewrite (= a!2 a!5)) a!5))
      (a!18 (unit-resolution (th-lemma a!14)
                             a!17
                             (>= (+ a!7 (* (- 1) s_boundary)) 0))))
(let ((a!19 (th-lemma a!18 (mp a!6 (rewrite (= a!5 a!8)) a!8) a!16 false)))
(let ((a!20 (unit-resolution (th-lemma a!12)
                             (unit-resolution (def-axiom a!13)
                                              (lemma a!19 a!15)
                                              (= a!7 s_global))
                             (>= (+ a!7 (* (- 1) s_global)) 0))))
  (th-lemma (mp a!6 (rewrite (= a!5 a!8)) a!8) a!11 a!20 false))))))
