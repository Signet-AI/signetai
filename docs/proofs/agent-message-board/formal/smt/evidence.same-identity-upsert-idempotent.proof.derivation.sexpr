(let ((a!1 (= (store (store v_artifacts v_key true) v_key true)
              (store v_artifacts v_key true)))
      (a!3 (rewrite (= (= (store v_artifacts v_key true)
                          (store v_artifacts v_key true))
                       true))))
(let ((a!2 (monotonicity (rewrite a!1)
                         (= a!1
                            (= (store v_artifacts v_key true)
                               (store v_artifacts v_key true))))))
(let ((a!4 (trans (monotonicity (trans a!2 a!3 (= a!1 true))
                                (= (not a!1) (not true)))
                  (rewrite (= (not true) false))
                  (= (not a!1) false))))
  (mp (asserted (not a!1)) a!4 false))))
