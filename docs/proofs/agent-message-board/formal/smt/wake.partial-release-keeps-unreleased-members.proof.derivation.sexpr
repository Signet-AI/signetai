(let ((a!1 (forall ((p_b Int) (p_m Int))
             (=> (and (p_mem p_b p_m) (not (p_ret p_m)))
                 (and (p_mem p_b p_m) (not (p_ret p_m))))))
      (a!2 (proof-bind (lambda ((p_b Int) (p_m Int))
                         (let ((a!1 (=> (and (p_mem p_b p_m) (not (p_ret p_m)))
                                        (and (p_mem p_b p_m) (not (p_ret p_m))))))
                           (rewrite (= a!1 true))))))
      (a!3 (forall ((p_b Int) (p_m Int)) true)))
(let ((a!4 (monotonicity (trans (quant-intro a!2 (= a!1 a!3))
                                (elim-unused (= a!3 true))
                                (= a!1 true))
                         (= (not a!1) (not true)))))
(let ((a!5 (trans a!4 (rewrite (= (not true) false)) (= (not a!1) false))))
  (mp (asserted (not a!1)) a!5 false))))
