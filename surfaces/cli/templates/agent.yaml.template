version: 1
schema: signet/v1

agent:
  name: "{{AGENT_NAME}}"
  description: "Personal AI assistant"
  created: "{{CREATED_AT}}"
  updated: "{{CREATED_AT}}"
harnesses:
  - claude-code
  - codex
  - opencode
  - openclaw

embedding:
  provider: ollama
  model: nomic-embed-text
  dimensions: 768

search:
  alpha: 0.7
  top_k: 20
  min_score: 0.3
  rehearsal_enabled: true

memory:
  database: memory/memories.db
  session_budget: 2000
  decay_rate: 0.95
  pipelineV2:
    enabled: true
    graph:
      enabled: true
    reranker:
      enabled: true
    autonomous:
      enabled: true
      allowUpdateDelete: true
      maintenanceMode: execute
    semanticContradictionEnabled: true
hooks:
  sessionStart:
    recallLimit: 10
    sessionContinuityMaxEntries: 15
    sessionContinuityMaxTokens: 3000
    sessionContinuityEntryMaxTokens: 250
    includeIdentity: true
    includeRecentContext: true
    recencyBias: 0.7
  preCompaction:
    summaryGuidelines: |
      Summarize this session focusing on:
      - Key decisions made
      - Important information learned
      - User preferences discovered
      - Open threads or todos
      - Any errors or issues encountered

      Keep the summary concise but complete.
    includeRecentMemories: true
    memoryLimit: 5
