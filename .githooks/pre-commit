#!/usr/bin/env bash
set -euo pipefail

if git diff --cached --name-only --diff-filter=ACMR | grep -Eq '\.(cjs|cts|js|json|jsonc|jsx|mjs|mts|ts|tsx)$'; then
  bunx biome check --staged
fi

if git diff --cached --name-only | grep -Eq '(^|/)(Cargo\.toml|Cargo\.lock|.*\.rs)$'; then
  (
    cd platform/daemon-rs
    cargo fmt --all -- --check
    cargo clippy --workspace --all-targets --all-features -- -D warnings
  )
fi
