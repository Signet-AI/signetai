# Defaults for `lme`. Override per command with env vars, e.g. GPU_TYPE="NVIDIA B200" lme up b200
SIGNET_REF=                               # empty = the commit this checkout is on (must be pushed); or a branch/tag/SHA
GPU_TYPE="NVIDIA H200"                    # fallback list allowed: "NVIDIA H200|NVIDIA B200"
CLOUD=SECURE                              # SECURE, COMMUNITY, or "COMMUNITY|SECURE" to try both
DATACENTERS="US-CA-2 US-NC-1 US-GA-2 US-CO-1 EU-FR-1 any"   # EUR-IS-4 measured 240-400 KB/s to GitHub and PyPI (vLLM install would take hours); "any" is the last resort
IMAGE=runpod/pytorch:1.4.2-rc.184-cu1290-torch291-ubuntu2404
CUDA_VERSIONS=""                          # optional allowedCudaVersions filter; any value tried so far matched no hosts, so BOOT_MIN fallback does the job
BOOT_MIN=15                               # lme up: give up on a pod that has not booted by then, try the next option
VOLUME_GB=200                             # /workspace: model 17G + venv ~12G + repo + run DBs/evidence
CONTAINER_GB=50
MODEL_REPO=RedHatAI/Qwen3.8-27B-INT4      # INT4 W4A16 + fp8 KV + MTP3 won the quant matrix (journal, docs/inference-recipes)
MAX_LEN=262144                            # >= 200K required for Dreaming
DREAM_CONC=12                             # one H200: keeps per-pass decode >= ~50 tok/s inside the 30 min pass deadline
DREAM_THINK=2000                          # Dreaming thinking budget per turn (thinking stays on)
DREAM_PLAN_THINK=                         # optional thinking budget for the turn after a large evidence page (empty = same as DREAM_THINK)
DREAM_MAX_OUT=16384                       # Dreaming max output tokens per turn, thinking included
QA_THINK=4000                             # answer + judge thinking budget
DREAM_TIMEOUT_MS=1800000
GRACE_MIN=30                              # watchdog: stop pod this long after the last run ends, pulled or not
HOLD_AFTER_PULL_MIN=10                    # watchdog: stop this long after the last run ends once everything is pulled
IDLE_MAX_MIN=90                           # watchdog: stop if serving this long with no run ever started
SM_VERSION=0.0.9
