---
// A product screenshot captured in both themes. The page shows the capture
// that matches the active site theme.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
	light: ImageMetadata;
	dark: ImageMetadata;
	alt: string;
	caption?: string;
}

const { light, dark, alt, caption } = Astro.props;
---

<figure class="shot">
	<Image src={light} alt={alt} class="shot-light" widths={[640, 1222]} sizes="(min-width: 50rem) 46rem, 100vw" />
	<Image src={dark} alt={alt} class="shot-dark" widths={[640, 1222]} sizes="(min-width: 50rem) 46rem, 100vw" />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.shot {
		margin-block: 1.25rem 2rem;
	}
	.shot :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--signet-border);
	}
	:global(:root[data-theme="dark"]) .shot :global(.shot-light),
	:global(:root[data-theme="light"]) .shot :global(.shot-dark) {
		display: none;
	}
	figcaption {
		margin-top: 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
</style>
