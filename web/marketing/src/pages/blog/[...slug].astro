---
import { render } from "astro:content";
import Blog from "../../layouts/Blog.astro";
import StructuredData from "../../components/StructuredData.astro";
import { getPosts, isoDate, postUrl, type Post } from "../../lib/blog";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, posts },
	}));
}

interface Props {
	post: Post;
	posts: Post[];
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const tags = new Set(post.data.tags);
const others = posts.filter((p) => p.id !== post.id);
const related = others
	.map((p) => ({ post: p, score: p.data.tags.filter((tag) => tags.has(tag)).length }))
	.filter((r) => r.score > 0)
	.sort((a, b) => b.score - a.score || b.post.data.date.getTime() - a.post.data.date.getTime())
	.map((r) => r.post);
const recommended = [...new Set([...related, ...others])].slice(0, 3);

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://signetai.sh";
const pageUrl = `${siteUrl}${postUrl(post)}`;
---

<Blog post={post} posts={posts} headings={headings} recommended={recommended} pageUrl={pageUrl}>
  <StructuredData data={{
    '@context': 'https://schema.org',
    '@type': post.data.category === 'announcement' ? 'NewsArticle' : 'TechArticle',
    headline: post.data.title,
    description: post.data.description,
    datePublished: isoDate(post.data.date),
    author: {
      '@type': 'Person',
      name: post.data.author,
    },
    url: pageUrl,
    publisher: {
      '@type': 'Organization',
      name: 'SignetAI',
      url: siteUrl,
    },
  }} />
  <StructuredData data={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: pageUrl },
    ],
  }} />
  <Content />
</Blog>
