---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import StructuredData from "../components/StructuredData.astro";
import Benchmark from "../components/home/Benchmark.astro";
import FromBlog from "../components/home/FromBlog.astro";
import HarnessStrip from "../components/home/HarnessStrip.astro";
import Harnesses from "../components/home/Harnesses.astro";
import Hero from "../components/home/Hero.astro";
import Interface from "../components/home/Interface.astro";
import Local from "../components/home/Local.astro";
import Sources from "../components/home/Sources.astro";
import Start from "../components/home/Start.astro";
import Story from "../components/home/Story.astro";
import Base from "../layouts/Base.astro";
import "../styles/blog.css";
import "../styles/home.css";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://signetai.sh";
---

<Base
  title="SignetAI | Local-First Memory &amp; Secrets for AI Agents"
  description="Portable, source-backed memory and secrets across Claude Code, OpenCode, OpenClaw, Codex, Gemini CLI, Pi, Oh My Pi, and Hermes Agent."
>
  <StructuredData data={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'SignetAI',
    url: siteUrl,
    description: "Local-first memory and secrets for AI agents. Portable across models and harnesses including Hermes Agent and OpenClaw.",
  }} />
  <StructuredData data={{
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Signet',
    url: siteUrl,
    description: "Portable, source-backed memory and secrets across Claude Code, OpenCode, OpenClaw, Codex, Gemini CLI, Pi, Oh My Pi, and Hermes Agent.",
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, macOS, Windows',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  }} />

  <Nav />
  <Hero />
  <main class="home">
    <HarnessStrip />
    <Interface />
    <Story />
    <Local />
    <Sources />
    <Harnesses />
    <Benchmark />
    <FromBlog />
    <Start />
  </main>
  <Footer />

  <script src="../scripts/interactions.ts"></script>
</Base>
