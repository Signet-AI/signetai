---
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import StructuredData from "../components/StructuredData.astro";
import Benchmark from "../components/landing/Benchmark.astro";
import FeatureSections from "../components/landing/FeatureSections.astro";
import Hero from "../components/landing/Hero.astro";
import InstallCta from "../components/landing/InstallCta.astro";
import Showcase from "../components/landing/Showcase.astro";
import Base from "../layouts/Base.astro";
import "../styles/landing.css";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://signetai.sh";
---

<Base
  title="SignetAI | Local-First Memory &amp; Secrets for AI Agents"
  description="Portable, source-backed memory and secrets across Claude Code, OpenCode, OpenClaw, Codex, Gemini CLI, Pi, Oh My Pi, and Hermes Agent."
>
  <StructuredData data={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'SignetAI',
    url: siteUrl,
    description: "Local-first memory and secrets for AI agents. Portable across models and harnesses including Hermes Agent and OpenClaw.",
  }} />
  <StructuredData data={{
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Signet',
    url: siteUrl,
    description: "Portable, source-backed memory and secrets across Claude Code, OpenCode, OpenClaw, Codex, Gemini CLI, Pi, Oh My Pi, and Hermes Agent.",
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, macOS, Windows',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  }} />

  <Nav />
  <main class="landing-page">
    <Hero />
    <Showcase />
    <FeatureSections />
    <Benchmark />
    <InstallCta />
    <Footer />
  </main>

  <script src="../scripts/interactions.ts"></script>
</Base>
