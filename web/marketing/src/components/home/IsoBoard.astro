---
import { HARNESSES } from "../../lib/harnesses";
const W = 1000;
const H = 640;
const S = 52;
const K = S * 0.866;
const CX = W / 2;
const CY = H / 2 - 10;

interface Pt {
	readonly x: number;
	readonly y: number;
}

function iso(gx: number, gy: number, z = 0): Pt {
	return { x: CX + (gx - gy) * K, y: CY + (gx + gy) * S * 0.5 - z * S };
}

function pts(...points: Pt[]): string {
	return points.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");
}
function prism(gx: number, gy: number, w: number, d: number, h: number, z = 0) {
	const t = z + h;
	return {
		top: pts(iso(gx, gy, t), iso(gx + w, gy, t), iso(gx + w, gy + d, t), iso(gx, gy + d, t)),
		right: pts(iso(gx + w, gy, t), iso(gx + w, gy + d, t), iso(gx + w, gy + d, z), iso(gx + w, gy, z)),
		left: pts(iso(gx, gy + d, t), iso(gx + w, gy + d, t), iso(gx + w, gy + d, z), iso(gx, gy + d, z)),
	};
}
function flat(gx: number, gy: number, size: number, z: number): string {
	const o = iso(gx, gy, z);
	return `matrix(${(size * K).toFixed(2)} ${(size * S * 0.5).toFixed(2)} ${(-size * K).toFixed(2)} ${(size * S * 0.5).toFixed(2)} ${o.x.toFixed(1)} ${o.y.toFixed(1)})`;
}

const BASE = 4.7;
const base = prism(-BASE, -BASE, BASE * 2, BASE * 2, 0.22, -0.22);
const dots: Pt[] = [];
for (let gx = -BASE + 0.35; gx < BASE; gx += 0.47) {
	for (let gy = -BASE + 0.35; gy < BASE; gy += 0.47) dots.push(iso(gx, gy));
}

const CORE = 1.25;
const core = prism(-CORE, -CORE, CORE * 2, CORE * 2, 1.05);
const coreTop = 1.05;
const SLOTS = [
	{ gx: -1, gy: -3.4, axis: "gy" },
	{ gx: 1, gy: -3.4, axis: "gy" },
	{ gx: 3.4, gy: -3.4, axis: "corner" },
	{ gx: 3.4, gy: -1, axis: "gx" },
	{ gx: 3.4, gy: 1, axis: "gx" },
	{ gx: 1, gy: 3.4, axis: "gy" },
	{ gx: -1, gy: 3.4, axis: "gy" },
	{ gx: -3.4, gy: 3.4, axis: "corner" },
	{ gx: -3.4, gy: 1, axis: "gx" },
	{ gx: -3.4, gy: -1, axis: "gx" },
	{ gx: -3.4, gy: -3.4, axis: "corner" },
] as const;

const TILE = 1.5;
const TILE_H = 0.32;
const center = iso(0, 0, coreTop / 2);

const tiles = HARNESSES.map((harness, i) => {
	const slot = SLOTS[i] ?? SLOTS[0];
	const gx = slot.gx - TILE / 2;
	const gy = slot.gy - TILE / 2;
	const top = iso(slot.gx, slot.gy, TILE_H);
	const sx = Math.sign(slot.gx);
	const sy = Math.sign(slot.gy);
	const half = TILE / 2;
	const from =
		slot.axis === "corner"
			? iso(slot.gx - sx * half, slot.gy - sy * half)
			: slot.axis === "gx"
				? iso(slot.gx - sx * half, slot.gy)
				: iso(slot.gx, slot.gy - sy * half);
	const to =
		slot.axis === "corner"
			? iso(sx * CORE, sy * CORE)
			: slot.axis === "gx"
				? iso(sx * CORE, slot.gy)
				: iso(slot.gx, sy * CORE);
	const dx = top.x - center.x;
	const dy = top.y - center.y;
	const len = Math.hypot(dx, dy) || 1;
	return {
		...harness,
		order: i,
		depth: slot.gx + slot.gy,
		box: prism(gx, gy, TILE, TILE, TILE_H),
		slot: prism(gx, gy, TILE, TILE, 0).top,
		ground: iso(slot.gx, slot.gy),
		print: flat(gx + 0.38, gy + 0.38, TILE - 0.76, TILE_H),
		trace: `M${from.x.toFixed(1)} ${from.y.toFixed(1)}L${to.x.toFixed(1)} ${to.y.toFixed(1)}`,
		ends: [from, to],
		out: { x: +(dx / len).toFixed(3), y: +(dy / len).toFixed(3) },
	};
});

const back = tiles.filter((t) => t.depth < 0).sort((a, b) => a.depth - b.depth);
const front = tiles.filter((t) => t.depth >= 0).sort((a, b) => a.depth - b.depth);
const leftFace = iso(0, CORE, 0.4);
const rightFace = iso(CORE, 0, 0.4);
const glowAt = iso(0, 0, 0);
const names = new Intl.ListFormat("en", { type: "conjunction" }).format(HARNESSES.map((h) => h.name));
const coreSlot = prism(-CORE, -CORE, CORE * 2, CORE * 2, 0).top;
---

<svg class="board" data-board viewBox="60 40 880 545" role="img" aria-label={`Signet sits at the center of a board, wired to ${names}.`}>
  <defs>
    <linearGradient id="board-top" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#10263a" />
      <stop offset="1" stop-color="#0a1925" />
    </linearGradient>
    <linearGradient id="core-top" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3a5ff0" />
      <stop offset="1" stop-color="#14248f" />
    </linearGradient>
    <linearGradient id="core-left" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1a2fa8" />
      <stop offset="1" stop-color="#0a1350" />
    </linearGradient>
    <linearGradient id="core-right" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#101f7a" />
      <stop offset="1" stop-color="#060c38" />
    </linearGradient>
    <linearGradient id="tile-top" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1d3a57" />
      <stop offset="1" stop-color="#122536" />
    </linearGradient>
    <radialGradient id="core-glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#3d5ff0" stop-opacity="0.55" />
      <stop offset="1" stop-color="#3d5ff0" stop-opacity="0" />
    </radialGradient>
  </defs>

  <g data-build="scene">
  <g class="board-base">
    <polygon points={base.left} fill="#071019" />
    <polygon points={base.right} fill="#050c13" />
    <polygon points={base.top} fill="url(#board-top)" stroke="rgba(153,180,214,0.22)" />
    <path fill="rgba(124,173,235,0.16)" d={dots.map((p) => `M${(p.x - 1.4).toFixed(1)} ${p.y.toFixed(1)}a1.4 0.8 0 1 0 2.8 0a1.4 0.8 0 1 0 -2.8 0`).join("")} />
  </g>

  <g class="board-slots" aria-hidden="true">
    <polygon class="board-slot" points={coreSlot} data-build="slot" data-order="core" />
    {tiles.map((t) => <polygon class="board-slot" points={t.slot} data-build="slot" data-order={t.order} />)}
  </g>

  <ellipse data-build="glow" cx={glowAt.x} cy={glowAt.y} rx={K * 3.4} ry={S * 1.7} fill="url(#core-glow)" />

  <g class="board-traces">
    {tiles.map((t) => (
      <g data-build="trace" data-order={t.order}>
        <path class="board-trace" d={t.trace} pathLength="1" />
        <path class="board-pulse" d={t.trace} />
        {t.ends.map((p) => <ellipse cx={p.x} cy={p.y} rx="4.5" ry="2.6" class="board-via" />)}
      </g>
    ))}
  </g>

  <g class="board-guides" aria-hidden="true">
    <line class="board-guide" x1={glowAt.x} y1={glowAt.y} x2={glowAt.x} y2={glowAt.y} data-build="guide" data-order="core" />
    {tiles.map((t) => (
      <line class="board-guide" x1={t.ground.x} y1={t.ground.y} x2={t.ground.x} y2={t.ground.y} data-build="guide" data-order={t.order} />
    ))}
  </g>

  {back.map((t) => (
    <a class="board-tile" data-tile={t.order} href={t.href} target="_blank" rel="noopener noreferrer" data-analytics-harness={t.analytics}>
      <title>{t.name} ({t.kind}), opens in a new tab</title>
      <g data-build="tile" data-order={t.order} data-ox={t.out.x} data-oy={t.out.y}>
        <g class="board-lift">
          <polygon points={t.box.left} fill="#0c1c2a" stroke="rgba(153,180,214,0.18)" />
          <polygon points={t.box.right} fill="#08141f" stroke="rgba(153,180,214,0.18)" />
          <polygon class="board-tile-top" points={t.box.top} fill="url(#tile-top)" stroke="rgba(153,180,214,0.35)" />
          <image class:list={[{ "logo-invert": t.invert }]} href={t.logo} width="1" height="1" transform={t.print} />
        </g>
      </g>
    </a>
  ))}

  <g class="board-core" data-build="core">
    <polygon points={core.left} fill="url(#core-left)" stroke="rgba(169,184,244,0.35)" />
    <polygon points={core.right} fill="url(#core-right)" stroke="rgba(169,184,244,0.35)" />
    <polygon points={core.top} fill="url(#core-top)" stroke="rgba(219,227,255,0.6)" />
    <image href="/favicon.svg" width="1" height="1" transform={flat(-0.7, -0.7, 1.4, coreTop)} />
    <text class="board-face" text-anchor="middle" transform={`matrix(0.866 0.5 0 1 ${leftFace.x.toFixed(1)} ${leftFace.y.toFixed(1)})`}>SIGNET</text>
    <text class="board-face board-face--dim" text-anchor="middle" transform={`matrix(0.866 -0.5 0 1 ${rightFace.x.toFixed(1)} ${rightFace.y.toFixed(1)})`}>MEMORY</text>
  </g>

  {front.map((t) => (
    <a class="board-tile" data-tile={t.order} href={t.href} target="_blank" rel="noopener noreferrer" data-analytics-harness={t.analytics}>
      <title>{t.name} ({t.kind}), opens in a new tab</title>
      <g data-build="tile" data-order={t.order} data-ox={t.out.x} data-oy={t.out.y}>
        <g class="board-lift">
          <polygon points={t.box.left} fill="#0c1c2a" stroke="rgba(153,180,214,0.18)" />
          <polygon points={t.box.right} fill="#08141f" stroke="rgba(153,180,214,0.18)" />
          <polygon class="board-tile-top" points={t.box.top} fill="url(#tile-top)" stroke="rgba(153,180,214,0.35)" />
          <image class:list={[{ "logo-invert": t.invert }]} href={t.logo} width="1" height="1" transform={t.print} />
        </g>
      </g>
    </a>
  ))}

  </g>
</svg>

<script>
  const clamp = (v: number): number => Math.min(1, Math.max(0, v));
  const ease = (v: number): number => 1 - (1 - v) ** 3;
  const settle = (v: number): number => 1 + 2.4 * (v - 1) ** 3 + 1.4 * (v - 1) ** 2;
  const span = (p: number, start: number, length: number): number => clamp((p - start) / length);

  const TILE_LIFT = [70, 92];
  const CORE_LIFT = 150;
  const SPREAD = 36;
  const DURATION = 2200;

  let stop: (() => void) | null = null;

  function initBoard() {
    stop?.();
    stop = null;
    const board = document.querySelector<SVGSVGElement>("[data-board]");
    if (!board || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const all = (name: string) => Array.from(board.querySelectorAll<SVGElement>(`[data-build="${name}"]`));
    const byOrder = (name: string) => {
      const map = new Map<string, SVGElement[]>();
      for (const el of all(name)) {
        const key = el.dataset.order ?? "";
        map.set(key, [...(map.get(key) ?? []), el]);
      }
      return map;
    };
    const glow = all("glow")[0];
    const core = all("core")[0];
    const tiles = byOrder("tile");
    const slots = byOrder("slot");
    const guides = byOrder("guide");
    const traces = byOrder("trace");
    const count = tiles.size;

    const lift = (key: string, height: number, landed: number) => {
      const y = height * (1 - landed);
      const spread = SPREAD * (1 - landed);
      for (const el of tiles.get(key) ?? []) {
        const ox = Number(el.dataset.ox ?? 0) * spread;
        const oy = Number(el.dataset.oy ?? 0) * spread * 0.5;
        el.style.transform = `translate(${ox}px, ${oy - y}px)`;
      }
      for (const el of slots.get(key) ?? []) el.style.opacity = String(clamp(1 - landed * 1.2));
      for (const el of guides.get(key) ?? []) {
        if (!(el instanceof SVGLineElement)) continue;
        el.setAttribute("y2", String(Number(el.getAttribute("y1")) - Math.max(0, y)));
        el.style.opacity = String(clamp(1 - landed * 1.4));
      }
    };

    function render(p: number) {
      if (!board) return;
      for (let i = 0; i < count; i++) {
        lift(String(i), TILE_LIFT[i % 2] ?? 70, settle(ease(span(p, 0.04 + i * 0.036, 0.26))));
      }
      const coreLanded = settle(ease(span(p, 0.42, 0.24)));
      if (core) core.style.transform = `translateY(${-CORE_LIFT * (1 - coreLanded)}px)`;
      lift("core", CORE_LIFT, coreLanded);
      for (let i = 0; i < count; i++) {
        const t = ease(span(p, 0.66 + i * 0.018, 0.16));
        for (const group of traces.get(String(i)) ?? []) {
          const line = group.querySelector<SVGPathElement>(".board-trace");
          if (line) line.style.strokeDashoffset = String(t - 1);
          for (const via of group.querySelectorAll<SVGElement>(".board-via")) via.style.opacity = String(t);
        }
      }
      if (glow) glow.style.opacity = String(0.25 + 0.75 * ease(span(p, 0.6, 0.4)));
      board.toggleAttribute("data-built", p >= 1);
    }

    let frame = 0;
    const play = () => {
      const start = performance.now();
      const tick = (now: number) => {
        const p = clamp((now - start) / DURATION);
        render(p);
        frame = p < 1 ? requestAnimationFrame(tick) : 0;
      };
      frame = requestAnimationFrame(tick);
    };

    board.setAttribute("data-animated", "");
    render(0);
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        play();
      },
      { threshold: 0.45 },
    );
    observer.observe(board);
    stop = () => {
      observer.disconnect();
      cancelAnimationFrame(frame);
    };
  }

  document.addEventListener("astro:page-load", initBoard);
</script>
