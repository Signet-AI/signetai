---
const options = [
	{
		id: "unix",
		label: "macOS and Linux",
		short: "macOS & Linux",
		prompt: "$",
		command: "curl -fsSL https://signetai.sh/install.sh | bash",
	},
	{
		id: "windows",
		label: "Windows",
		short: "Windows",
		prompt: "PS>",
		command: "iwr -useb https://signetai.sh/install.ps1 | iex",
	},
];

const placement = Astro.props.placement ?? "install_selector";
---

<div class:list={["install-os-selector", { "install-os-selector--compact": placement === "hero" || Astro.props.compact }]} data-install-os-selector>
  <div class="install-os-label">Install for your operating system</div>
  <div class="install-os-tabs" role="tablist" aria-label="Choose your operating system">
    {options.map((option, index) => (
      <button
        type="button"
        class:list={["install-os-tab", { active: index === 0 }]}
        role="tab"
        aria-label={option.label}
        title={option.label}
        aria-selected={index === 0 ? "true" : "false"}
        aria-controls={`install-os-panel-${placement}-${option.id}`}
        data-install-os={option.id}
        data-analytics-install-surface={placement}
        data-analytics-install-option={option.id}
      >
        {option.id === "windows" ? (
          <svg class="install-os-tab-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3 5.2 11 4.1v7.45H3V5.2Zm9.5-1.33L21 2.7v8.85h-8.5V3.87ZM3 12.95H11v7.45L3 19.3v-6.35Zm9.5 0H21v8.85l-8.5-1.2v-7.65Z" />
          </svg>
        ) : (
          <span class="install-os-icon-pair" aria-hidden="true">
            <svg class="install-os-tab-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M15.7 5.2c-.8.9-1.8 1.4-2.9 1.3-.1-1.1.3-2.2 1-3 .8-.9 1.9-1.4 2.9-1.4.1 1.1-.3 2.2-1 3.1Z" />
              <path d="M18.5 12.6c0-2.5 2-3.7 2.1-3.8-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-2-.9-3.3-.9-1.7 0-3.2 1-4.1 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.3 2.5 1.3-.1 1.8-.8 3.4-.8s2 .8 3.4.8c1.4 0 2.3-1.2 3.2-2.5.9-1.3 1.3-2.6 1.3-2.7-.1 0-3.4-1.3-3.4-4.3Z" />
            </svg>
            <svg class="install-os-tab-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.8c-2.5 0-4.3 2.5-4.3 5.5 0 1.7-.7 2.8-1.4 4-.8 1.4-1.4 2.9-.8 4.4.6 1.4 2.1 2.1 3.6 1.7 1.1-.3 1.9-.9 2.9-.9s1.8.6 2.9.9c1.5.4 3-.3 3.6-1.7.6-1.5 0-3-.8-4.4-.7-1.2-1.4-2.3-1.4-4C16.3 5.3 14.5 2.8 12 2.8Z" />
              <path d="M8.9 16.2c.8-.5 1.8-.8 3.1-.8s2.3.3 3.1.8c-.4.9-1.4 1.4-3.1 1.4s-2.7-.5-3.1-1.4Z" />
              <circle cx="10" cy="10.4" r=".65" fill="var(--color-bg)" />
              <circle cx="14" cy="10.4" r=".65" fill="var(--color-bg)" />
            </svg>
          </span>
        )}
        <span class="install-os-name">{option.short}</span>
      </button>
    ))}
  </div>

  <div class="install-os-panels">
    {options.map((option, index) => (
      <div
        id={`install-os-panel-${placement}-${option.id}`}
        class:list={["install-os-panel", { active: index === 0 }]}
        role="tabpanel"
        aria-label={`${option.label} install command`}
        data-install-os-panel={option.id}
        hidden={index !== 0}
      >
        <div class="install-box">
          <span class="install-prompt">{option.prompt}</span>
          <code class="install-cmd">{option.command}</code>
          <button
            type="button"
            class="copy-btn push-right"
            data-copy={option.command}
            data-analytics-command={option.id === "windows" ? "native_install_windows" : "native_install"}
            data-analytics-placement={placement}
            aria-label={`Copy ${option.label} install command`}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <svg class="copy-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="4 12 9 17 20 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    ))}
  </div>
</div>
