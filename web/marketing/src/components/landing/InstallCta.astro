---
import OsInstallSelector from "./OsInstallSelector.astro";
---

<section id="install" class="container install-final-section" style="border-top: 1px solid var(--color-border)">
  <div class="section-header reveal">
    <div class="crosshair"></div>
    <span class="section-label">GET STARTED</span>
    <span class="section-index">07 / 07</span>
  </div>

  <div class="install-final reveal">
    <div class="install-final-lead">
      <div class="install-final-copy">
        <h2 class="install-final-title">Persistent memory<br /><em>in five minutes.</em></h2>
        <p class="install-final-sub">Install the CLI, then finish first-run setup in guided dashboard onboarding. No cloud account required.</p>
      </div>
      <aside class="install-final-aside">
        <span class="install-final-time">05:00</span>
        <span class="install-final-time-label">TO FIRST MEMORY</span>
        <span class="install-final-aside-rule" aria-hidden="true"></span>
        <p>One command. A local workspace. The next session starts with context already in place.</p>
      </aside>
	    </div>

	    <div class="install-final-console">
	      <OsInstallSelector placement="install_cta" />

      <div class="install-path" aria-label="First session steps">
        <div class="install-path-head">
          <span>AFTER THE FIRST COMMAND</span>
          <span>THREE SMALL STEPS</span>
        </div>
        <ol class="install-path-list">
          <li>
            <span>01</span>
            <div>
              <strong>Install</strong>
              <p>Run the command above. Your local daemon starts with it.</p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <strong>Connect</strong>
              <p>Bring the harnesses you already use into the same workspace.</p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <strong>Remember</strong>
              <p>Save one preference. Recall it when the next session begins.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>

    <div class="install-final-footer">
      <div class="install-final-meta">
        <span>Apache 2.0</span>
        <span class="install-final-sep">&middot;</span>
        <span>Open Source</span>
        <span class="install-final-sep">&middot;</span>
        <span>Local-first</span>
      </div>
      <div class="install-final-links">
        <a href="https://discord.gg/pHa5scah9C" target="_blank" rel="noopener noreferrer" class="btn btn-primary" data-analytics-cta="join_discord" data-analytics-placement="install_cta">Join Discord</a>
        <a href="https://docs.signetai.sh/quickstart/" class="btn btn-ghost" data-analytics-guide="quickstart">Quickstart docs</a>
        <a href="https://github.com/Signet-AI/signetai" class="btn btn-ghost">GitHub</a>
      </div>
    </div>
  </div>
</section>
