---
const tabs = [
	{
		id: "install",
		label: "01 · Install",
		lines: [
			{ type: "cmd", text: "curl -fsSL https://signetai.sh/install.sh | bash" },
			{ type: "out", text: "✓ binary linked · workspace initialized · daemon started" },
			{ type: "cmd", text: "signet status" },
			{ type: "out", text: "● daemon running · memory pipeline healthy" },
		],
	},
	{
		id: "setup",
		label: "02 · Setup",
		lines: [
			{ type: "cmd", text: "signet setup" },
			{ type: "out", text: "agent name [atlas]: signet setup --identity-mode off" },
			{ type: "out", text: "✓ harness detected: claude-code · hooks installed" },
			{ type: "out", text: "✓ embedding provider: built-in (on-device)" },
		],
	},
	{
		id: "work",
		label: "03 · Work",
		lines: [
			{ type: "cmd", text: 'signet remember "prefers bun over npm"' },
			{ type: "out", text: "✓ memory saved · source-backed" },
			{ type: "cmd", text: 'signet recall "package manager preference"' },
			{ type: "out", text: "→ prefers bun over npm (source: transcript 2026-08-07)" },
		],
	},
];
---

<section id="install" class="container install-final-section" style="border-top: 1px solid var(--color-border)">
  <div class="section-header reveal">
    <div class="crosshair"></div>
    <span class="section-label">GET STARTED</span>
    <span class="section-index">07 / 07</span>
  </div>

  <div class="install-final reveal">
    <h2 class="install-final-title">Persistent memory in five minutes.</h2>
    <p class="install-final-sub">Install the binary, run the wizard, start working. No cloud account, no migration.</p>

    <div class="install-terminal">
      <div class="install-terminal-tabs" role="tablist" aria-label="Getting started steps">
        {tabs.map((tab, i) => (
          <button
            type="button"
            class:list={["install-terminal-tab", { active: i === 0 }]}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            data-tab={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </div>
      <div class="install-terminal-body">
        {tabs.map((tab, i) => (
          <div class:list={["install-terminal-panel", { active: i === 0 }]} data-panel={tab.id} role="tabpanel">
            {tab.lines.map((line) => (
              line.type === "cmd" ? (
                <div class="install-term-cmd">
                  <span class="install-term-p">$</span> {line.text}
                </div>
              ) : (
                <div class="install-term-out">{line.text}</div>
              )
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="install-final-footer">
      <div class="install-final-meta">
        <span>Apache 2.0</span>
        <span class="install-final-sep">&middot;</span>
        <span>Open Source</span>
        <span class="install-final-sep">&middot;</span>
        <span>Local-first</span>
      </div>
      <div class="install-final-links">
        <a href="/join" class="btn btn-primary">Join Community</a>
        <a href="https://docs.signetai.sh/quickstart/" class="btn btn-ghost">Quickstart docs</a>
        <a href="https://github.com/Signet-AI/signetai" class="btn btn-ghost">GitHub</a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.install-terminal-tabs').forEach((tabGroup) => {
    const tabs = tabGroup.querySelectorAll('.install-terminal-tab');
    const panels = tabGroup.parentElement.querySelectorAll('.install-terminal-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.toggle('active', t === tab);
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
        });
        panels.forEach((p) => p.classList.toggle('active', p.dataset.panel === tab.dataset.tab));
      });
    });
  });
</script>
