---
import OsInstallSelector from "./OsInstallSelector.astro";
---

<section class="hero">
  <!-- Keep the original hero image; the overlays only improve legibility. -->
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="container hero-container">
    <div class="hero-grid reveal">
      <div class="hero-eyebrow">MEMORY + SECRETS, OUTSIDE THE HARNESS</div>

      <h1 class="hero-title"><span>Own your agent.</span><span>Bring it anywhere.</span></h1>

      <p class="hero-desc">
        Signet is a local-first memory and context layer for AI agents. Keep memory inspectable and portable, and keep credentials out of the model’s view.
      </p>

      <div class="hero-install">
        <OsInstallSelector placement="hero" />
        <div class="hero-cta-row">
          <a href="/join" class="btn hero-discord-btn" data-analytics-cta="join_community" data-analytics-placement="hero">
            Join Discord <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="hero-harnesses">
        <span class="hero-harnesses-label">PORTABLE CONTEXT ACROSS THE ECOSYSTEM</span>
        <div class="hero-harnesses-row">
          <a href="https://docs.anthropic.com/en/docs/claude-code" target="_blank" rel="noopener noreferrer" class="hero-harness-item" data-analytics-harness="claude_code">
            <img src="/dashboard/logos/claude.svg" alt="" width="18" height="18" loading="lazy" />
            <span>Claude Code</span>
          </a>
          <a href="https://github.com/sst/opencode" target="_blank" rel="noopener noreferrer" class="hero-harness-item" data-analytics-harness="opencode">
            <img src="/dashboard/logos/opencode.svg" alt="" width="18" height="18" loading="lazy" />
            <span>OpenCode</span>
          </a>
          <a href="https://github.com/openclaw/openclaw" target="_blank" rel="noopener noreferrer" class="hero-harness-item" data-analytics-harness="openclaw">
            <img src="/dashboard/logos/openclaw.svg" alt="" width="18" height="18" loading="lazy" />
            <span>OpenClaw</span>
          </a>
          <a href="https://github.com/openai/codex" target="_blank" rel="noopener noreferrer" class="hero-harness-item" data-analytics-harness="codex">
            <img src="/dashboard/logos/openai.svg" alt="" width="18" height="18" loading="lazy" />
            <span>Codex</span>
          </a>
          <a href="https://github.com/NousResearch/hermes-agent" target="_blank" rel="noopener noreferrer" class="hero-harness-item" data-analytics-harness="hermes_agent">
            <img src="/harness-logos/hermes-agent-32.png" alt="" width="18" height="18" loading="lazy" />
            <span>Hermes Agent</span>
          </a>
          <a href="https://github.com/google-gemini/gemini-cli" target="_blank" rel="noopener noreferrer" class="hero-harness-item" data-analytics-harness="gemini_cli">
            <img src="/dashboard/logos/gemini.svg" alt="" width="18" height="18" loading="lazy" />
            <span>Gemini CLI</span>
          </a>
          <a href="https://github.com/Signet-AI/signetai/tree/main/integrations/pi/connector" target="_blank" rel="noopener noreferrer" class="hero-harness-item" data-analytics-harness="pi">
            <img src="/dashboard/logos/pi.svg" alt="" width="18" height="18" loading="lazy" />
            <span>Pi</span>
          </a>
          <a href="https://github.com/Signet-AI/signetai/tree/main/integrations/oh-my-pi/connector" target="_blank" rel="noopener noreferrer" class="hero-harness-item" data-analytics-harness="oh_my_pi">
            <img src="/dashboard/logos/oh-my-pi.svg" alt="" width="18" height="18" loading="lazy" />
            <span>Oh My Pi</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(ellipse 82% 64% at 52% 42%, rgba(29, 49, 91, 0.32) 0%, rgba(29, 49, 91, 0.06) 58%, transparent 84%),
      linear-gradient(180deg, rgba(4, 15, 26, 0.42) 0%, rgba(4, 15, 26, 0.2) 48%, rgba(4, 15, 26, 0.78) 100%),
      linear-gradient(110deg, rgba(4, 15, 26, 0.64) 0%, rgba(4, 15, 26, 0.18) 48%, rgba(4, 15, 26, 0.62) 100%),
      url("/hero-bg.avif");
    background-size: cover;
    background-position: center 42%;
  }

  .hero-cta-row {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-md);
  }

  .hero-discord-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
</style>
