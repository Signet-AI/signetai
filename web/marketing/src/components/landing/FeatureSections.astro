---
const sectionLinks = [
	{ index: "02", label: "DREAMING", target: "feature-dream" },
	{ index: "03", label: "LOCAL", target: "feature-local" },
	{ index: "04", label: "HARNESSES", target: "feature-harness" },
	{ index: "05", label: "SOURCES", target: "feature-sources" },
];

const harnesses = [
	{
		name: "Claude Code",
		key: "claude",
		kind: "session hooks",
		logo: "/dashboard/logos/claude.svg",
		href: "https://docs.anthropic.com/en/docs/claude-code",
	},
	{
		name: "OpenCode",
		key: "opencode",
		kind: "runtime plugin",
		logo: "/dashboard/logos/opencode.svg",
		href: "https://github.com/sst/opencode",
	},
	{
		name: "OpenClaw",
		key: "openclaw",
		kind: "runtime adapter",
		logo: "/dashboard/logos/openclaw.svg",
		href: "https://github.com/openclaw/openclaw",
	},
	{
		name: "Codex",
		key: "codex",
		kind: "hooks + MCP",
		logo: "/dashboard/logos/openai.svg",
		href: "https://github.com/openai/codex",
	},
	{
		name: "Hermes Agent",
		key: "hermes",
		kind: "memory provider",
		logo: "/dashboard/logos/hermes-agent.svg",
		href: "https://github.com/NousResearch/hermes-agent",
	},
	{
		name: "Gemini CLI",
		key: "gemini",
		kind: "MCP + GEMINI.md",
		logo: "/dashboard/logos/gemini.svg",
		href: "https://github.com/google-gemini/gemini-cli",
	},
	{
		name: "Pi",
		key: "pi",
		kind: "connector",
		logo: "/dashboard/logos/pi.svg",
		href: "https://github.com/Signet-AI/signetai/tree/main/integrations/pi/connector",
	},
	{
		name: "Oh My Pi",
		key: "ohmypi",
		kind: "runtime extension",
		logo: "/dashboard/logos/oh-my-pi.svg",
		href: "https://github.com/Signet-AI/signetai/tree/main/integrations/oh-my-pi/connector",
	},
];
---

<section id="capabilities" class="feature-sections" aria-labelledby="capabilities-heading">
	<div class="container">
		<nav class="feature-nav" aria-label="Capability sections">
			<span class="feature-nav-label">CAPABILITIES</span>
			<span class="feature-nav-rule" aria-hidden="true"></span>
			<span class="feature-nav-range">02 — 05</span>
			<ul>
				{sectionLinks.map((item) => (
					<li><a href={`#${item.target}`}><span>{item.index}</span>{item.label}</a></li>
				))}
			</ul>
		</nav>

		<header class="feature-manifesto reveal">
			<div class="manifesto-index">THE MEMORY LAYER<br />02 — 05</div>
			<div class="manifesto-copy">
				<p class="feature-kicker">PERSISTENT CONTEXT, WITHOUT THE BLACK BOX</p>
				<h2 id="capabilities-heading">Keep the work.<br /><em>Lose the reset.</em></h2>
				<p>
					Signet keeps the useful parts of a working relationship — decisions, preferences,
					people, and evidence — available wherever the next session starts.
				</p>
			</div>
			<div class="manifesto-aside"><span>01</span><p>memory should outlive the interface that created it</p></div>
		</header>

		<article id="feature-dream" class="dream-bento" aria-labelledby="dream-heading">
			<header class="dream-bento-head reveal">
				<div class="dream-bento-index"><span class="slice-index">02 / 05</span><span class="slice-kicker">DREAMING</span></div>
				<h3 id="dream-heading">It gets smarter<br /><span>after you leave.</span></h3>
				<p>When a session goes idle, Signet turns the transcript into durable memory, then quietly keeps it current. No save button. No extra prompt.</p>
			</header>
			<div class="dream-bento-grid">
				<div class="dream-bento-tile dream-bento-tile--note reveal">
					<span class="dream-bento-tile-label">01 / 03 · SESSION</span>
					<strong>WORK<br /><span>ENDS.</span></strong>
					<span class="dream-bento-tile-rule" aria-hidden="true"></span>
					<small>the memory layer picks up where the harness leaves off</small>
				</div>
				<div class="dream-flow reveal" role="img" aria-label="A session moves through dreaming and becomes source-backed memory.">
					<div class="dream-flow-label"><span>SESSION → MEMORY</span><span>01 / 03</span></div>
					<div class="dream-flow-orb" aria-hidden="true"></div>
					<div class="dream-flow-track" aria-hidden="true"></div>
					<div class="dream-flow-node dream-flow-node--session"><span class="dream-node-dot"></span><strong>SESSION</strong><small>work ends</small></div>
					<div class="dream-flow-node dream-flow-node--dream"><span class="dream-node-glyph dream-node-glyph--dream" aria-hidden="true"></span><strong>DREAMING</strong><small>distill · supersede</small></div>
					<div class="dream-flow-node dream-flow-node--memory"><span class="dream-node-glyph dream-node-glyph--memory" aria-hidden="true"></span><strong>MEMORY</strong><small>ready next time</small></div>
				</div>
				<div class="dream-bento-tile dream-bento-tile--ledger reveal">
					<span class="dream-bento-tile-label">02 / 03 · DREAMING LOOP</span>
					<div class="dream-ledger">
						<div><span>01</span><strong>Distill</strong><p>turn the transcript into a useful shape</p></div>
						<div><span>02</span><strong>Supersede</strong><p>replace stale claims instead of stacking them</p></div>
						<div><span>03</span><strong>Retain</strong><p>keep the graph useful between sessions</p></div>
					</div>
				</div>
				<div class="dream-bento-tile dream-bento-tile--memory reveal">
					<span class="dream-bento-tile-label">03 / 03 · NEXT SESSION</span>
					<strong>CONTEXT<br /><em>KEPT.</em></strong>
					<div class="dream-memory-bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
					<small>source-backed by default</small>
				</div>
				<div class="dream-bento-tile dream-bento-tile--quiet reveal">
					<span class="dream-bento-tile-label">THE PROMISE</span>
					<p>No save button.<br />No extra prompt.</p>
					<span class="dream-quiet-mark" aria-hidden="true"></span>
				</div>
			</div>
		</article>

		<section id="feature-local" class="local-band" aria-labelledby="local-heading">
			<div class="local-band-top">
				<span class="slice-index">03 / 05</span>
				<span class="slice-kicker">LOCAL BY DEFAULT</span>
				<span class="local-band-tag">NO CLOUD ACCOUNT REQUIRED</span>
			</div>
			<div class="local-band-grid">
				<div class="local-band-copy reveal">
					<h3 id="local-heading">Yours to run.<br />Yours to move.</h3>
					<p>One binary, a SQLite workspace, and a daemon on your machine. Your context is portable files — not a subscription-shaped silo.</p>
				</div>
				<div class="local-measures reveal">
					<div><span>01</span><strong>ONE BINARY</strong><p>install the full stack in one command</p></div>
					<div><span>02</span><strong>READABLE FILES</strong><p>back up, inspect, or move your workspace</p></div>
					<div><span>03</span><strong>LOCAL RECALL</strong><p>search and ranking stay on-device</p></div>
				</div>
			</div>
		</section>

		<section id="feature-harness" class="harness-slice" aria-labelledby="harness-heading">
			<div class="harness-slice-top">
				<div class="harness-slice-heading reveal">
					<span class="slice-index">04 / 05</span>
					<p class="slice-kicker">PORTABLE CONTEXT</p>
					<h3 id="harness-heading">One context.<br /><span>Every harness.</span></h3>
				</div>
				<div class="harness-slice-copy reveal">
					<p>Signet installs underneath the tools you already use. Switch shells without starting over — the same memory and secrets follow.</p>
					<span class="harness-count">08 CONNECTORS / ONE MEMORY LAYER</span>
				</div>
			</div>
			<div class="harness-ribbon reveal" aria-label="Supported agent harnesses">
				{harnesses.map((harness) => (
					<a class="harness-link" data-logo={harness.key} href={harness.href} target="_blank" rel="noopener noreferrer">
						<span class="harness-mark" aria-hidden="true"><img src={harness.logo} alt="" width="34" height="34" loading="lazy" /></span>
						<span class="harness-link-copy"><strong>{harness.name}</strong><small>{harness.kind}</small></span>
						<span class="harness-link-arrow" aria-hidden="true">↗</span>
					</a>
				))}
			</div>
			<div class="harness-slice-foot"><span></span><p>the harness is where the work happens — memory is what travels</p><a href="https://docs.signetai.sh/harnesses/" target="_blank" rel="noopener noreferrer">read the connector docs ↗</a></div>
		</section>

		<section id="feature-sources" class="sources-slice" aria-labelledby="sources-heading">
			<div class="sources-copy reveal">
				<span class="slice-index">05 / 05</span>
				<p class="slice-kicker">SOURCE-BACKED</p>
				<h3 id="sources-heading">Every answer<br /><span>has a receipt.</span></h3>
				<p class="slice-body">Notes, transcripts, repos, and documents stay ground truth. Derived memory can change; the evidence it came from never disappears underneath it.</p>
				<a class="text-link" href="https://docs.signetai.sh/memory/" target="_blank" rel="noopener noreferrer">how provenance works ↗</a>
			</div>
			<div class="receipt-object reveal" role="img" aria-label="A memory claim linked to a source artifact with a receipt.">
				<div class="receipt-object-header"><span>MEMORY CLAIM</span><span>INSPECTABLE</span></div>
				<div class="receipt-object-main">
					<div class="receipt-object-claim">
						<p>“The dashboard scopes every query to the active agent.”</p>
						<div class="receipt-object-meta"><span>source: hermes-agent</span><span>line 42</span><span>2d ago</span></div>
					</div>
					<div class="receipt-object-source-panel">
						<span class="receipt-object-source-label">ORIGIN ARTIFACT</span>
						<div class="receipt-object-source"><span>↳</span><strong>session-2026-09-09.md</strong><small>open source</small></div>
						<div class="receipt-object-source-lines" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
					</div>
				</div>
				<div class="receipt-object-footer"><span>CLAIM 01</span><span>LINKED AT INGEST</span><span class="receipt-object-stamp">SOURCE RECEIPT <b>VALID</b></span></div>
			</div>
			<div class="sources-foot reveal"><span>01</span><span>artifact</span><span>02</span><span>claim</span><span>03</span><span>receipt</span></div>
		</section>
	</div>
</section>

<style>
	.feature-sections {
		border-top: 1px solid var(--color-border);
		padding-block: 0;
	}

	.feature-nav {
		display: grid;
		grid-template-columns: auto minmax(40px, 1fr) auto minmax(0, 2.4fr);
		gap: 14px;
		align-items: center;
		padding: 24px 0;
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.feature-nav-label { color: var(--color-text-bright); font-weight: 600; }
	.feature-nav-range { color: var(--color-text-muted); }
	.feature-nav-rule { border-top: 1px solid var(--color-border-strong); }
	.feature-nav ul { display: flex; justify-content: space-between; gap: 18px; list-style: none; }
	.feature-nav a { color: var(--color-text-muted); text-decoration: none; transition: color var(--dur) var(--ease); }
	.feature-nav a:hover, .feature-nav a:focus-visible { color: var(--color-text-bright); }
	.feature-nav a span { margin-right: 8px; color: var(--color-accent); }

	.feature-kicker,
	.slice-kicker,
	.slice-index,
	.manifesto-index,
	.manifesto-aside,
	.local-band-tag,
	.harness-count,
	.harness-link-copy small,
	.harness-slice-foot,
	.receipt-object-header,
	.receipt-object-meta,
	.receipt-object-source,
	.sources-foot {
		font-family: var(--font-mono);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.feature-kicker,
	.slice-kicker { color: var(--color-highlight-text); font-size: 0.64rem; font-weight: 600; }
	.slice-index,
	.manifesto-index,
	.local-band-tag,
	.harness-count,
	.harness-slice-foot,
	.receipt-object-header,
	.receipt-object-meta,
	.receipt-object-source,
	.sources-foot { color: var(--color-text-muted); font-size: 0.59rem; }

	.feature-manifesto {
		display: grid;
		grid-template-columns: 150px minmax(0, 1fr) 200px;
		gap: clamp(36px, 7vw, 104px);
		align-items: end;
		min-height: min(650px, 74vh);
		padding-block: clamp(84px, 12vw, 170px) clamp(92px, 11vw, 150px);
		border-bottom: 1px solid var(--color-border);
	}

	.manifesto-index { align-self: start; line-height: 1.7; }
	.manifesto-copy { max-width: 900px; }
	.manifesto-copy h2 {
		margin-top: 22px;
		font-family: var(--font-body);
		font-size: clamp(3.5rem, 8.2vw, 8.6rem);
		font-weight: 500;
		line-height: 0.9;
		letter-spacing: -0.075em;
		text-transform: none;
	}
	.manifesto-copy h2 em { color: var(--color-highlight-text); font-style: normal; }
	.manifesto-copy > p:last-child { max-width: 620px; margin-top: 38px; color: var(--color-text); font-size: clamp(1rem, 1.5vw, 1.18rem); line-height: 1.65; }
	.manifesto-aside { align-self: end; display: flex; gap: 12px; line-height: 1.55; }
	.manifesto-aside span { color: var(--color-accent); }
	.manifesto-aside p { max-width: 150px; }

	.dream-bento {
		padding-block: clamp(100px, 13vw, 180px);
		border-bottom: 1px solid var(--color-border);
	}
	.dream-bento-head { width: min(820px, 100%); margin: 0 auto; text-align: center; }
	.dream-bento-index { display: flex; justify-content: center; align-items: center; gap: 18px; }
	.dream-bento-head h3 { margin-top: 24px; font-family: var(--font-body); font-size: clamp(3.6rem, 6.6vw, 6.8rem); font-weight: 500; line-height: .9; letter-spacing: -.075em; text-transform: none; }
	.dream-bento-head h3 span { color: var(--color-highlight-text); }
	.dream-bento-head > p { max-width: 650px; margin: 32px auto 0; color: var(--color-text); font-size: 1.03rem; line-height: 1.7; }
	.dream-bento-grid { max-width: 1120px; margin: clamp(64px, 8vw, 104px) auto 0; display: grid; grid-template-columns: minmax(180px, .72fr) minmax(460px, 1.6fr) minmax(180px, .72fr); grid-template-rows: minmax(450px, 1fr) auto; gap: 18px; align-items: stretch; }
	.dream-bento-tile { position: relative; min-width: 0; overflow: hidden; padding: 24px; border: 1px solid var(--color-border-strong); background: rgba(12, 30, 46, .55); }
	.dream-bento-tile::after { content: ""; position: absolute; inset: auto -22% -62% 24%; height: 180px; background: radial-gradient(ellipse, rgba(120,146,232,.13), transparent 70%); pointer-events: none; }
	.dream-bento-tile-label { display: block; color: var(--color-text-muted); font: .58rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
	.dream-bento-tile--note { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; justify-content: space-between; align-self: center; min-height: 250px; background: rgba(12, 30, 46, .28); border-color: rgba(169,184,244,.28); }
	.dream-bento-tile--note strong { color: var(--color-text-bright); font-family: var(--font-body); font-size: clamp(1.85rem, 3vw, 2.65rem); font-weight: 500; line-height: .92; letter-spacing: -.06em; }
	.dream-bento-tile--note strong span { color: var(--color-highlight-text); }
	.dream-bento-tile-rule { display: block; width: 34px; border-top: 1px solid var(--color-highlight-text); opacity: .7; }
	.dream-bento-tile small { color: var(--color-text-muted); font: .6rem/1.45 var(--font-mono); letter-spacing: .02em; }
	.dream-bento-tile--ledger { grid-column: 3; grid-row: 1; align-self: center; min-height: 250px; padding-bottom: 16px; background: rgba(12, 30, 46, .28); border-color: rgba(169,184,244,.28); }
	.dream-ledger { margin-top: 16px; border-top: 1px solid var(--color-border-strong); }
	.dream-ledger > div { display: grid; grid-template-columns: 26px 70px minmax(0, 1fr); gap: 7px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--color-border); }
	.dream-ledger span { color: var(--color-accent); font: .58rem var(--font-mono); }
	.dream-ledger strong { color: var(--color-text-bright); font: .64rem var(--font-mono); letter-spacing: .04em; }
	.dream-ledger p { color: var(--color-text-muted); font-size: .7rem; line-height: 1.3; }
	.dream-bento-tile--memory { grid-column: 1 / 2; grid-row: 2; display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: center; padding-block: 18px; }
	.dream-bento-tile--memory strong { color: var(--color-text-bright); font-family: var(--font-body); font-size: clamp(1.5rem, 2.4vw, 2.1rem); font-weight: 500; line-height: .92; letter-spacing: -.06em; }
	.dream-bento-tile--memory strong em { color: var(--color-highlight-text); font-style: normal; }
	.dream-memory-bars { grid-column: 2; display: flex; align-items: end; gap: 5px; height: 34px; justify-content: flex-end; }
	.dream-memory-bars span { display: block; width: 8px; border: 1px solid rgba(169,184,244,.5); background: rgba(169,184,244,.2); }
	.dream-memory-bars span:nth-child(1) { height: 14px; }
	.dream-memory-bars span:nth-child(2) { height: 21px; }
	.dream-memory-bars span:nth-child(3) { height: 30px; background: rgba(169,184,244,.42); }
	.dream-memory-bars span:nth-child(4) { height: 19px; }
	.dream-memory-bars span:nth-child(5) { height: 25px; background: rgba(169,184,244,.3); }
	.dream-bento-tile--memory small { grid-column: 2; text-align: right; }
	.dream-bento-tile--quiet { grid-column: 3; grid-row: 2; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 18px; padding-block: 18px; }
	.dream-bento-tile--quiet p { max-width: 170px; color: var(--color-text); font-size: .82rem; line-height: 1.45; }
	.dream-quiet-mark { position: relative; display: block; width: 38px; height: 38px; border: 1px solid rgba(169,184,244,.44); border-radius: 50%; flex: 0 0 auto; }
	.dream-quiet-mark::before, .dream-quiet-mark::after { content: ""; position: absolute; inset: 10px; border: 1px solid rgba(169,184,244,.42); border-radius: 50%; }
	.dream-quiet-mark::after { inset: 17px; background: var(--color-highlight-text); border: 0; box-shadow: 0 0 15px rgba(169,184,244,.8); }

	.dream-flow { position: relative; grid-column: 2; grid-row: 1; min-height: 500px; overflow: hidden; padding: 20px 24px; color: var(--color-highlight-text); border: 1px solid rgba(135,157,235,.5); background: radial-gradient(circle at 50% 52%, rgba(35,67,102,.48), rgba(8,22,34,.96) 68%); box-shadow: 0 28px 70px rgba(0,0,0,.22); }
	.dream-flow::before { content: ""; position: absolute; inset: 8% 12%; border: 1px solid rgba(135,157,235,.08); border-radius: 50%; transform: rotate(-18deg); pointer-events: none; }
	.dream-flow::after { content: ""; position: absolute; inset: 12% 16%; border-radius: 50%; background: radial-gradient(circle, rgba(169,184,244,.52) 0 1px, transparent 1.5px) 0 0 / 10px 10px; opacity: .16; -webkit-mask-image: radial-gradient(circle at 50% 48%, #000 0 52%, transparent 72%); mask-image: radial-gradient(circle at 50% 48%, #000 0 52%, transparent 72%); pointer-events: none; }
	.dream-flow-label { position: relative; z-index: 1; display: flex; justify-content: space-between; color: var(--color-text-muted); font: .59rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
	.dream-flow-orb { position: absolute; z-index: 1; left: 50%; top: 50%; width: min(58%, 320px); aspect-ratio: 1; transform: translate(-50%, -50%); border: 1px solid rgba(169,184,244,.33); border-radius: 50%; background: radial-gradient(circle at 38% 30%, rgba(169,184,244,.22), rgba(13,32,50,.24) 45%, rgba(13,32,50,.04) 70%); box-shadow: 0 0 0 18px rgba(135,157,235,.04), 0 0 0 42px rgba(135,157,235,.025), inset 0 0 70px rgba(120,146,232,.14); }
	.dream-flow-orb::before, .dream-flow-orb::after { content: ""; position: absolute; inset: 16%; border: 1px solid rgba(169,184,244,.14); border-radius: 50%; transform: rotate(34deg) scaleX(.55); }
	.dream-flow-orb::after { transform: rotate(-34deg) scaleX(.55); }
	.dream-flow-track { position: absolute; z-index: 2; left: 10%; right: 10%; top: 56%; border-top: 1px solid rgba(169,184,244,.38); }
	.dream-flow-track::after { content: ""; position: absolute; left: 0; right: 0; top: -3px; height: 5px; background: linear-gradient(90deg, transparent, rgba(169,184,244,.36), transparent); opacity: .35; }
	.dream-flow-node { position: absolute; z-index: 3; top: calc(56% - 22px); display: flex; flex-direction: column; align-items: center; gap: 7px; min-width: 92px; transform: translateX(-50%); text-align: center; }
	.dream-flow-node--session { left: 10%; }
	.dream-flow-node--dream { left: 50%; top: calc(56% - 34px); min-width: 150px; padding: 18px 20px; border: 1px solid rgba(169,184,244,.58); border-radius: 999px; background: rgba(14,33,50,.88); box-shadow: 0 0 0 9px rgba(135,157,235,.05), 0 0 26px rgba(120,146,232,.12); }
	.dream-flow-node--memory { left: 90%; }
	.dream-flow-node strong { color: var(--color-text-bright); font: .62rem var(--font-mono); letter-spacing: .12em; }
	.dream-flow-node small { color: var(--color-text-muted); font: .55rem var(--font-mono); letter-spacing: .03em; }
	.dream-node-dot { width: 24px; height: 24px; border: 1px solid rgba(135,157,235,.62); border-radius: 50%; background: #0b1b27; box-shadow: inset 0 0 0 6px rgba(135,157,235,.14), 0 0 14px rgba(120,146,232,.15); }
	.dream-node-glyph { display: block; width: 26px; height: 26px; border: 1px solid rgba(169,184,244,.56); border-radius: 50%; background: rgba(16,34,57,.86); }
	.dream-node-glyph--dream { position: relative; border-color: var(--color-highlight-text); box-shadow: 0 0 18px rgba(169,184,244,.2); }
	.dream-node-glyph--dream::before, .dream-node-glyph--dream::after { content: ""; position: absolute; left: 6px; right: 6px; top: 12px; border-top: 1px solid var(--color-highlight-text); }
	.dream-node-glyph--dream::after { transform: rotate(90deg); }

	.local-band-copy h3,
	.harness-slice-heading h3,
