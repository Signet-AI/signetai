---
const sectionLinks = [
	{ index: "02", label: "DREAMING", target: "feature-dream" },
	{ index: "03", label: "LOCAL", target: "feature-local" },
	{ index: "04", label: "HARNESSES", target: "feature-harness" },
	{ index: "05", label: "SOURCES", target: "feature-sources" },
];

const harnesses = [
	{
		name: "Claude Code",
		key: "claude",
		kind: "session hooks",
		logo: "/dashboard/logos/claude.svg",
		href: "https://docs.anthropic.com/en/docs/claude-code",
	},
	{
		name: "OpenCode",
		key: "opencode",
		kind: "runtime plugin",
		logo: "/dashboard/logos/opencode.svg",
		href: "https://github.com/sst/opencode",
	},
	{
		name: "OpenClaw",
		key: "openclaw",
		kind: "runtime adapter",
		logo: "/dashboard/logos/openclaw.svg",
		href: "https://github.com/openclaw/openclaw",
	},
	{
		name: "Codex",
		key: "codex",
		kind: "hooks + MCP",
		logo: "/dashboard/logos/openai.svg",
		href: "https://github.com/openai/codex",
	},
	{
		name: "Hermes Agent",
		key: "hermes",
		kind: "memory provider",
		logo: "/dashboard/logos/hermes-agent.svg",
		href: "https://github.com/NousResearch/hermes-agent",
	},
	{
		name: "Gemini CLI",
		key: "gemini",
		kind: "MCP + GEMINI.md",
		logo: "/dashboard/logos/gemini.svg",
		href: "https://github.com/google-gemini/gemini-cli",
	},
	{
		name: "Pi",
		key: "pi",
		kind: "connector",
		logo: "/dashboard/logos/pi.svg",
		href: "https://github.com/Signet-AI/signetai/tree/main/integrations/pi/connector",
	},
	{
		name: "Oh My Pi",
		key: "ohmypi",
		kind: "runtime extension",
		logo: "/dashboard/logos/oh-my-pi.svg",
		href: "https://github.com/Signet-AI/signetai/tree/main/integrations/oh-my-pi/connector",
	},
];
---

<section id="capabilities" class="feature-sections" aria-labelledby="capabilities-heading">
	<div class="container">
		<nav class="feature-nav" aria-label="Capability sections">
			<span class="feature-nav-label">CAPABILITIES</span>
			<span class="feature-nav-rule" aria-hidden="true"></span>
			<span class="feature-nav-range">02 — 05</span>
			<ul>
				{sectionLinks.map((item) => (
					<li><a href={`#${item.target}`}><span>{item.index}</span>{item.label}</a></li>
				))}
			</ul>
		</nav>

		<header class="feature-manifesto reveal">
			<div class="manifesto-index">THE MEMORY LAYER<br />02 — 05</div>
			<div class="manifesto-copy">
				<p class="feature-kicker">PERSISTENT CONTEXT, WITHOUT THE BLACK BOX</p>
				<h2 id="capabilities-heading">Keep the work.<br /><em>Lose the reset.</em></h2>
				<p>
					Signet keeps the useful parts of a working relationship — decisions, preferences,
					people, and evidence — available wherever the next session starts.
				</p>
			</div>
			<div class="manifesto-aside"><span>01</span><p>memory should outlive the interface that created it</p></div>
		</header>

		<div class="memory-layer-bento" aria-label="Memory layer capabilities">
			<article class="memory-layer-card memory-layer-card--signal reveal">
				<div class="memory-card-top"><span>THE MEMORY LAYER</span><span>01 / 04</span></div>
				<div class="memory-signal-copy">
					<p class="memory-card-kicker">ONE WORKSPACE / FOUR KINDS OF CONTEXT</p>
					<h3>Everything useful,<br /><em>still here.</em></h3>
				</div>
				<div class="memory-rack" aria-hidden="true">
					<div class="memory-rack-row"><span class="memory-rack-dot"></span><span>decisions</span><span class="memory-rack-line"></span><span>retained</span></div>
					<div class="memory-rack-row"><span class="memory-rack-dot"></span><span>preferences</span><span class="memory-rack-line"></span><span>portable</span></div>
					<div class="memory-rack-row"><span class="memory-rack-dot"></span><span>people</span><span class="memory-rack-line"></span><span>linked</span></div>
					<div class="memory-rack-row"><span class="memory-rack-dot"></span><span>evidence</span><span class="memory-rack-line"></span><span>inspectable</span></div>
				</div>
				<p class="memory-card-foot">Source-backed memory that stays available across sessions.</p>
			</article>

			<article class="memory-layer-card memory-layer-card--accent reveal">
				<p class="memory-card-kicker">INSPECTABLE BY DEFAULT</p>
				<h3>Readable<br /><em>by design.</em></h3>
				<p>Every claim keeps a path back to its source. Nothing important disappears into a black box.</p>
				<span class="memory-accent-mark" aria-hidden="true"><i></i><i></i><i></i></span>
			</article>

			<article class="memory-layer-card memory-layer-card--small reveal">
				<div class="memory-card-top"><span>02 / 04</span><span>LOCAL</span></div>
				<strong>PORTABLE<br /><em>FILES.</em></strong>
				<p>Back up, inspect, or move the workspace without asking permission.</p>
			</article>

			<article class="memory-layer-card memory-layer-card--wide reveal">
				<div class="memory-card-top"><span>03 / 04</span><span>ONE MEMORY LAYER</span></div>
				<div class="memory-wide-body">
					<div><h4>Decisions, people, preferences, evidence.</h4><p>Keep the useful parts of a working relationship together, wherever the next session starts.</p></div>
					<div class="memory-bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
				</div>
			</article>
		</div>

		<article id="feature-dream" class="dream-bento" aria-labelledby="dream-heading">
			<header class="dream-bento-head reveal">
				<div class="dream-bento-index"><span class="slice-index">02 / 05</span><span class="slice-kicker">DREAMING</span></div>
				<h3 id="dream-heading">It gets smarter<br /><span>after you leave.</span></h3>
				<p>When a session goes idle, Signet turns the transcript into durable memory, then quietly keeps it current. No save button. No extra prompt.</p>
			</header>
			<div class="dream-bento-grid">
				<article class="dream-bento-card dream-bento-card--core reveal">
					<div class="dream-card-top"><span>SESSION → MEMORY</span><span>01 / 03</span></div>
					<div class="dream-core-intro">
						<p class="dream-card-kicker">WHEN THE WINDOW CLOSES</p>
						<h4>Work ends.<br /><em>Context stays.</em></h4>
						<p>The memory layer picks up where the harness leaves off, then keeps the useful parts ready for next time.</p>
					</div>
					<div class="dream-signal-field" aria-hidden="true">
						<div class="dream-signal-grid"></div>
						<div class="dream-signal-route"><span></span><i></i><b></b><em></em></div>
						<div class="dream-signal-caption"><span>SESSION</span><span>DREAMING</span><span>MEMORY</span></div>
					</div>
				</article>

				<article class="dream-bento-card dream-bento-card--loop reveal">
					<div class="dream-card-top"><span>02 / 03 · DREAMING LOOP</span><span>QUIET WORK</span></div>
					<h4>Three quiet<br /><span>moves.</span></h4>
					<ol class="dream-loop-list">
						<li><span>01</span><div><strong>Distill</strong><p>turn the transcript into a useful shape</p></div></li>
						<li><span>02</span><div><strong>Supersede</strong><p>replace stale claims instead of stacking them</p></div></li>
						<li><span>03</span><div><strong>Retain</strong><p>keep the graph useful between sessions</p></div></li>
					</ol>
				</article>

				<article class="dream-bento-card dream-bento-card--ready reveal">
					<div class="dream-card-top"><span>03 / 03 · NEXT SESSION</span><span>READY</span></div>
					<h4>Ready<br /><em>when you are.</em></h4>
					<div class="dream-ready-state"><span class="dream-ready-dot"></span><strong>SOURCE-BACKED</strong><small>available on return</small></div>
				</article>

				<article class="dream-bento-card dream-bento-card--promise reveal">
					<div class="dream-promise-copy"><span class="dream-card-kicker">THE PROMISE</span><p>No save button.<br /><em>No extra prompt.</em></p></div>
					<div class="dream-promise-rail" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
				</article>
			</div>
		</article>

		<section id="feature-local" class="local-band" aria-labelledby="local-heading">
			<div class="local-band-top">
				<span class="slice-index">03 / 05</span>
				<span class="slice-kicker">LOCAL BY DEFAULT</span>
				<span class="local-band-tag">NO CLOUD ACCOUNT REQUIRED</span>
			</div>
			<div class="local-band-grid">
				<div class="local-band-copy reveal">
					<h3 id="local-heading">Yours to run.<br />Yours to move.</h3>
					<p>One binary, a SQLite workspace, and a daemon on your machine. Your context is portable files — not a subscription-shaped silo.</p>
				</div>
				<div class="local-signal reveal" aria-label="A local Signet workspace stays on your machine">
					<div class="local-signal-top"><span>WORKSPACE / LOCAL</span><span>NO ACCOUNT</span></div>
					<div class="local-signal-route" aria-hidden="true">
						<span>AGENT</span><i></i><span>SIGNET</span><i></i><span>FILES</span>
					</div>
					<div class="local-signal-path">~/.agents/signet</div>
					<p>Memory, sources, and secrets stay with the workspace.</p>
				</div>
				<div class="local-measures reveal">
					<div><span>01</span><strong>ONE BINARY</strong><p>install the full stack in one command</p></div>
					<div><span>02</span><strong>READABLE FILES</strong><p>back up, inspect, or move your workspace</p></div>
					<div><span>03</span><strong>LOCAL RECALL</strong><p>search and ranking stay on-device</p></div>
				</div>
			</div>
		</section>

		<section id="feature-harness" class="harness-slice" aria-labelledby="harness-heading">
			<div class="harness-slice-top">
				<div class="harness-slice-heading reveal">
					<span class="slice-index">04 / 05</span>
					<p class="slice-kicker">PORTABLE CONTEXT</p>
					<h3 id="harness-heading">One context.<br /><span>Every harness.</span></h3>
				</div>
				<div class="harness-slice-copy reveal">
					<p>Signet installs underneath the tools you already use. Switch shells without starting over — the same memory and secrets follow.</p>
					<span class="harness-count">08 CONNECTORS / ONE MEMORY LAYER</span>
				</div>
			</div>
			<div class="harness-ribbon reveal" aria-label="Supported agent harnesses">
				{harnesses.map((harness) => (
					<a class="harness-link" data-logo={harness.key} href={harness.href} target="_blank" rel="noopener noreferrer">
						<span class="harness-mark" aria-hidden="true"><img src={harness.logo} alt="" width="34" height="34" loading="lazy" /></span>
						<span class="harness-link-copy"><strong>{harness.name}</strong><small>{harness.kind}</small></span>
						<span class="harness-link-arrow" aria-hidden="true">↗</span>
					</a>
				))}
			</div>
			<div class="harness-slice-foot"><span></span><p>the harness is where the work happens — memory is what travels</p><a href="https://docs.signetai.sh/harnesses/" target="_blank" rel="noopener noreferrer">read the connector docs ↗</a></div>
		</section>

		<section id="feature-sources" class="sources-slice" aria-labelledby="sources-heading">
			<div class="sources-copy reveal">
				<span class="slice-index">05 / 05</span>
				<p class="slice-kicker">SOURCE-BACKED / TRACEABLE ANSWERS</p>
				<h3 id="sources-heading">See where<br /><span>it came from.</span></h3>
				<p class="slice-body">Signet links every memory to the note, transcript, or file it came from. Open the receipt to inspect the exact source before you trust the answer.</p>
				<a class="text-link" href="https://docs.signetai.sh/memory/" target="_blank" rel="noopener noreferrer">read the provenance guide ↗</a>
			</div>
			<div class="sources-proof-grid reveal" role="group" aria-label="A memory claim linked to a source artifact with a receipt.">
				<article class="sources-proof-claim">
					<div class="sources-proof-top"><span>MEMORY CLAIM / SOURCE ATTACHED</span><span>VALID</span></div>
					<p>“The context from our last session is still here — with the source attached.”</p>
					<div class="sources-proof-meta"><span>source: session-2026-09-09</span><span>claim 01</span><span>2d ago</span></div>
				</article>
				<article class="sources-proof-chain">
					<div class="sources-proof-top"><span>HOW THIS ANSWER WAS BUILT</span><span>SOURCE → CLAIM → RECEIPT</span></div>
					<ol class="source-chain">
						<li><span>01</span><div><strong>Artifact</strong><p>session-2026-09-09.md</p></div><small>ground truth</small></li>
						<li><span>02</span><div><strong>Claim</strong><p>context retained</p></div><small>derived</small></li>
						<li><span>03</span><div><strong>Receipt</strong><p>line 42 · inspectable</p></div><small>valid</small></li>
					</ol>
				</article>
			</div>
			<div class="sources-foot reveal"><span>01</span><span>artifact</span><span>02</span><span>claim</span><span>03</span><span>receipt</span></div>
		</section>
	</div>
</section>

<style>
	.feature-sections {
		border-top: 1px solid var(--color-border);
		padding-block: 0;
	}

	.feature-nav {
		display: grid;
		grid-template-columns: auto minmax(40px, 1fr) auto minmax(0, 2.4fr);
		gap: 14px;
		align-items: center;
		padding: 24px 0;
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.feature-nav-label { color: var(--color-text-bright); font-weight: 600; }
	.feature-nav-range { color: var(--color-text-muted); }
	.feature-nav-rule { border-top: 1px solid var(--color-border-strong); }
	.feature-nav ul { display: flex; justify-content: space-between; gap: 18px; list-style: none; }
	.feature-nav a { color: var(--color-text-muted); text-decoration: none; transition: color var(--dur) var(--ease); }
	.feature-nav a:hover, .feature-nav a:focus-visible { color: var(--color-text-bright); }
	.feature-nav a span { margin-right: 8px; color: var(--color-accent); }

	.feature-kicker,
	.slice-kicker,
	.slice-index,
	.manifesto-index,
	.manifesto-aside,
	.local-band-tag,
	.harness-count,
	.harness-link-copy small,
	.harness-slice-foot,
	.sources-foot {
		font-family: var(--font-mono);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.feature-kicker,
	.slice-kicker { color: var(--color-highlight-text); font-size: 0.64rem; font-weight: 600; }
	.slice-index,
	.manifesto-index,
	.local-band-tag,
	.harness-count,
	.harness-slice-foot,
	.sources-foot { color: var(--color-text-muted); font-size: 0.59rem; }

	.feature-manifesto {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(180px, 220px);
		gap: clamp(28px, 6vw, 96px);
		align-items: end;
		min-height: clamp(420px, 58vh, 620px);
		padding-block: clamp(78px, 10vw, 140px) clamp(68px, 8vw, 116px);
		border-bottom: 1px solid var(--color-border);
	}

	.manifesto-index { grid-column: 1 / -1; align-self: start; line-height: 1.7; }
	.manifesto-copy { grid-column: 1; max-width: 900px; }
	.manifesto-copy h2 {
		margin-top: 22px;
		font-family: var(--font-body);
		font-size: clamp(3.5rem, 8.2vw, 8.6rem);
		font-weight: 500;
		line-height: 0.9;
		letter-spacing: -0.075em;
		text-transform: none;
	}
	.manifesto-copy h2 em { color: var(--color-highlight-text); font-style: normal; }
	.manifesto-copy > p:last-child { max-width: 620px; margin-top: 38px; color: var(--color-text); font-size: clamp(1rem, 1.5vw, 1.18rem); line-height: 1.65; }
	.manifesto-aside { grid-column: 2; align-self: end; display: flex; gap: 12px; line-height: 1.55; }
	.manifesto-aside span { color: var(--color-accent); }
	.manifesto-aside p { max-width: 150px; }

	.memory-layer-bento {
		max-width: 1120px;
		margin: clamp(44px, 7vw, 88px) auto clamp(92px, 12vw, 156px);
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
		grid-template-rows: minmax(380px, auto) minmax(196px, auto);
		gap: 18px;
	}
	.memory-layer-card {
		position: relative;
		min-width: 0;
		overflow: hidden;
		padding: clamp(24px, 3vw, 38px);
		border: 1px solid var(--color-border-strong);
		background: rgba(12, 30, 46, 0.56);
	}
	.memory-card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		color: var(--color-text-muted);
		font: 0.58rem var(--font-mono);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.memory-card-kicker {
		color: var(--color-highlight-text);
		font: 0.62rem var(--font-mono);
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.memory-layer-card--signal {
		grid-column: 1;
		grid-row: 1;
		min-height: 380px;
		display: flex;
		flex-direction: column;
		background: linear-gradient(140deg, rgba(16, 39, 59, 0.92), rgba(8, 22, 34, 0.82));
	}
	.memory-signal-copy { margin-top: auto; }
	.memory-signal-copy h3,
	.memory-layer-card--accent h3 {
		margin-top: 18px;
		font-family: var(--font-body);
		font-size: clamp(2.5rem, 5vw, 5.4rem);
		font-weight: 500;
		line-height: 0.92;
		letter-spacing: -0.07em;
		text-transform: none;
	}
	.memory-signal-copy h3 em,
	.memory-layer-card--accent h3 em,
	.memory-layer-card--small strong em { color: var(--color-highlight-text); font-style: normal; }
	.memory-rack {
		margin-top: clamp(30px, 4vw, 48px);
		border-top: 1px solid rgba(169, 184, 244, 0.2);
		border-bottom: 1px solid rgba(169, 184, 244, 0.2);
	}
	.memory-rack-row {
		display: grid;
		grid-template-columns: 8px minmax(90px, 0.55fr) minmax(100px, 1fr) auto;
		align-items: center;
		gap: 12px;
		min-height: 36px;
		border-bottom: 1px solid rgba(169, 184, 244, 0.12);
		font: 0.62rem var(--font-mono);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.memory-rack-row:last-child { border-bottom: 0; }
	.memory-rack-row > span:nth-child(2) { color: var(--color-text); }
	.memory-rack-row > span:last-child { color: var(--color-text-muted); font-size: 0.54rem; }
	.memory-rack-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--color-highlight-text); box-shadow: 0 0 10px rgba(169, 184, 244, 0.65); }
	.memory-rack-line { position: relative; height: 3px; overflow: hidden; background: linear-gradient(90deg, rgba(120, 146, 232, 0.18), rgba(169, 184, 244, 0.7), rgba(120, 146, 232, 0.12)); }
	.memory-rack-line::after { content: ""; position: absolute; inset: 0 auto 0 -26%; width: 26%; background: var(--color-text-bright); box-shadow: 0 0 10px var(--color-highlight-text); animation: memory-scan 3.8s linear infinite; }
	.memory-rack-row:nth-child(2) .memory-rack-line::after { animation-delay: -1.2s; }
	.memory-rack-row:nth-child(3) .memory-rack-line::after { animation-delay: -2.1s; }
	.memory-rack-row:nth-child(4) .memory-rack-line::after { animation-delay: -2.8s; }
	.memory-card-foot { margin-top: 22px; color: var(--color-text-muted); font-size: 0.78rem; line-height: 1.45; }
	.memory-layer-card--accent {
		grid-column: 2;
		grid-row: 1;
		display: flex;
		flex-direction: column;
		min-height: 380px;
		background: var(--color-highlight-text);
		color: #0b1725;
		border-color: rgba(169, 184, 244, 0.9);
	}
	.memory-layer-card--accent .memory-card-kicker { color: #3a5680; }
	.memory-layer-card--accent h3 { color: #0b1725; font-size: clamp(2.4rem, 4.2vw, 4.4rem); }
	.memory-layer-card--accent h3 em { color: #425f90; }
	.memory-layer-card--accent > p:last-of-type { max-width: 280px; margin-top: 28px; color: #31496b; font-size: 0.9rem; line-height: 1.55; }
	.memory-accent-mark { display: flex; align-items: end; gap: 6px; min-height: 74px; margin-top: auto; }
	.memory-accent-mark i { display: block; width: 12px; height: 32px; background: rgba(11, 23, 37, 0.52); }
	.memory-accent-mark i:nth-child(2) { height: 54px; background: rgba(11, 23, 37, 0.68); }
	.memory-accent-mark i:nth-child(3) { height: 40px; background: rgba(11, 23, 37, 0.36); }
	.memory-layer-card--small {
		grid-column: 1;
		grid-row: 2;
		display: grid;
		grid-template-columns: minmax(110px, 0.8fr) minmax(0, 1fr);
		gap: 24px;
		align-items: end;
		background:
			linear-gradient(105deg, rgba(7, 18, 29, .24) 0%, rgba(7, 18, 29, .08) 54%, rgba(7, 18, 29, .02) 100%),
			url("/portable-files-bg.png") center 52% / cover no-repeat;
		border-color: rgba(169, 184, 244, .34);
	}
	.memory-layer-card--small .memory-card-top { grid-column: 1 / -1; align-self: start; }
	.memory-layer-card--small strong { color: var(--color-text-bright); font: 500 clamp(1.5rem, 2.5vw, 2.35rem)/0.9 var(--font-body); letter-spacing: -0.06em; }
	.memory-layer-card--small p { max-width: 270px; color: var(--color-text-muted); font-size: 0.78rem; line-height: 1.45; }
	.memory-layer-card--wide {
		grid-column: 2;
		grid-row: 2;
		background: rgba(18, 37, 54, 0.66);
	}
	.memory-wide-body { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 30px; align-items: end; height: calc(100% - 28px); padding-top: 28px; }
